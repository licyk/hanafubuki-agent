{
  "name": "{{name}}",
  "version": "0.1.0",
  "description": "A hanafubuki-agent plugin written in Rust.",
  "runtime": {
    "type": "process",
    "command": ["./{{name}}"],
    "protocol": "kardia-guest/2"
  },
  "contributes": {
    "tools": [
      {
        "name": "greet",
        "description": "Greets someone by name.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "description": "Who to greet." }
          },
          "required": ["name"],
          "additionalProperties": false
        },
        "timeout": 10
      }
    ],
    "contextSections": [{ "kind": "{{kind}}_status" }],
    "observers": ["turn_finished"]
  },
  "permissions": {
    "network": false,
    "workspace": "read",
    "env": []
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "greeting": { "type": "string", "description": "What a greeting starts with." }
    },
    "additionalProperties": false
  }
}
