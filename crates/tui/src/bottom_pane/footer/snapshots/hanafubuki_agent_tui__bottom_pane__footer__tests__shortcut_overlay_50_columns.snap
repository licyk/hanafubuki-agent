"  Keyboard shortcuts                              "
"                                                  "
"  Compose                                         "
"  /         Commands                              "
"  @         Mention files                         "
"  !         Shell command                         "
"  ctrl + j  New line                              "
"  ctrl + g  External editor                       "
"  ctrl + r  Search history                        "
"  esc esc   Edit last message                     "
"                                                  "
"  Session                                         "
"  tab            Send message                     "
"  shift + tab    Change mode                      "
"  ⌥ + ,          Less reasoning                   "
"  ⌥ + .          More reasoning                   "
"  ←              Agents (empty prompt)            "
"  ⌥ + ← / ⌥ + →  Subagents (empty prompt)         "
"  f4             Inspect activity                 "
"  ctrl + c       Quit                             "
"                                                  "
"  Transcript (open first)                         "
"  ctrl + t                       Open transcript  "
"  f3                             Find text        "
"  pgup / pgdn                    Scroll           "
"  ctrl + space                   Start selection  "
"  ctrl + home / ctrl + end       Top / latest     "
"  shift + ⌥ + , / shift + ⌥ + .  Top / latest     "
"                                                  "
"  /keymap customize                               "
