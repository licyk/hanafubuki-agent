  "tools": {
    "skills_list": {
      "description": "List the Skills available for this turn. Each entry carries the id every other Skill tool takes, its name, its description, and its directory. Follow cursor until next_cursor is absent.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "authority": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "repo",
              "user",
              "system",
              null
            ]
          },
          "cursor": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 256
          }
        },
        "additionalProperties": false
      },
      "exposure": "direct",
      "allowedInPlanMode": true
    },
    "skills_read": {
      "description": "Read one Skill. Omit path to adopt the Skill for this turn: its SKILL.md is added to the conversation once, as a <skill> block. Otherwise pass a package-relative path the catalog listed and follow next_cursor until absent.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "skill": {
            "type": "string",
            "minLength": 6,
            "maxLength": 200,
            "pattern": "^(system|user|repo):[^/][^\\\\:]*$"
          },
          "path": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              {
                "type": "null"
              }
            ]
          },
          "cursor": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 256
          }
        },
        "required": [
          "skill"
        ],
        "additionalProperties": false
      },
      "exposure": "direct",
      "allowedInPlanMode": true
    },
    "enable_skill": {
      "description": "Turn one Skill on for future user turns after explicit approval. This does not change the current turn.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "skill": {
            "type": "string",
            "minLength": 6,
            "maxLength": 200,
            "pattern": "^(system|user|repo):[^/][^\\\\:]*$"
          }
        },
        "required": [
          "skill"
        ],
        "additionalProperties": false
      },
      "exposure": "deferred",
      "allowedInPlanMode": false
    },
    "disable_skill": {
      "description": "Turn one Skill off for future user turns after explicit approval. This does not rewrite the current or past turns.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "skill": {
            "type": "string",
            "minLength": 6,
            "maxLength": 200,
            "pattern": "^(system|user|repo):[^/][^\\\\:]*$"
          }
        },
        "required": [
          "skill"
        ],
        "additionalProperties": false
      },
      "exposure": "deferred",
      "allowedInPlanMode": false
    }
  },
